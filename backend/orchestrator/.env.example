# --- Orchestrator server ---
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Downstream agent microservices ---
EXTRACTION_AGENT_URL=http://localhost:8001
REDFLAG_AGENT_URL=http://localhost:8002

# --- Document Agent (imported in-process; point at its .py file if you move it) ---
# DOCUMENT_AGENT_PATH=../document Agent/document_agent.py

# --- Storage (all default to ./data if left blank) ---
# DATA_DIR=./data

# --- Research Agent / LLM (shared Groq key with the other agents) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
