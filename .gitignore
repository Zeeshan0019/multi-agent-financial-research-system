# ==============================================================================
#  Multi-Agent Financial Research System — .gitignore
# ==============================================================================

# ─── Secrets & environment ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ─── Databases (regenerated at runtime) ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/database/financial_research.db

# ─── Vector store (rebuilt from source PDFs) ─────────────────────────────────
vector_store/
faiss_index/
*.faiss
*.index

# ─── Uploaded & generated files ──────────────────────────────────────────────
uploads/
backend/uploads/
outputs/
reports/
*.tmp
scratch/

# ─── ML model caches ─────────────────────────────────────────────────────────
.cache/
models/
sentence-transformers/
.huggingface/
*.bin
*.pt
*.onnx

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Node / Frontend (Vite + React) ──────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing / coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────────────────────
*.bak
*.orig